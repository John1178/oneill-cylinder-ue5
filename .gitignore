# ---------------------------------------------------------------
# Unreal Engine — generated / regenerable. Never commit these.
# ---------------------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Plugin build output (source IS tracked, output is not)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ---------------------------------------------------------------
# Third-party marketplace / sample content.
# Re-downloadable from the Epic Launcher, and redistributing paid
# marketplace assets in a public repo breaks their licence.
# Re-install these locally after cloning.
# ---------------------------------------------------------------
Content/StarterContent/
Content/UltraDynamicSky/
Content/VehicleTemplate/
Content/Vehicles/
# World Partition stores a level's actors OUTSIDE its content folder, so the
# vehicle pack's own map needs its external actor/object folders ignored too.
Content/__ExternalActors__/VehicleTemplate/
Content/__ExternalObjects__/VehicleTemplate/
# Generic template input assets that arrived with the vehicle pack.
# Verified 2026-09-14: nothing outside the pack references them.
Content/Input/

# ---------------------------------------------------------------
# Visual Studio / Rider
# ---------------------------------------------------------------
.vs/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# ---------------------------------------------------------------
# Local backups (created during the MCP plugin install)
# ---------------------------------------------------------------
*.bak_before_mcp
*.bak_before_unreal
*.bak

# ---------------------------------------------------------------
# Python bytecode cache (regenerated on import)
# ---------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------
# Blender automatic backups (regenerated on save)
# ---------------------------------------------------------------
*.blend1

# ---------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
